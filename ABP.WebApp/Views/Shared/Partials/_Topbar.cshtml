@{
    var title = ViewData["Title"] as string ?? "Home";
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var userName = User.Identity?.Name ?? "Usuario";
    var initial = char.ToUpperInvariant(userName.FirstOrDefault());
}
<header class="app-topbar">
    <nav class="flex items-center gap-2 text-sm" aria-label="Breadcrumb">
        @if (!string.IsNullOrEmpty(area))
        {
            <span class="text-ink-faint">@area</span>
            <span class="text-ink-faint">/</span>
        }
        <span class="font-medium text-ink">@title</span>
    </nav>
    <div class="flex items-center gap-3">
        <span class="text-sm text-ink-muted">@userName</span>
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink text-xs font-semibold text-white">
            @initial
        </span>
    </div>
</header>
