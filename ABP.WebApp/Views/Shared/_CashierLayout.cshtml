@{
    Layout = "_AppLayout";
}

@section SidebarItems {
    <partial name="Partials/_SidebarItem" model='new SidebarItemViewModel { Text = "Home", Icon = "home", Area = "Cashier", Controller = "Home", Action = "Index" }' />
    <partial name="Partials/_SidebarItem" model='new SidebarItemViewModel { Text = "Depósito", Icon = "arrow-down-to-line", Area = "Cashier", Controller = "Transactions", Action = "Deposit" }' />
    <partial name="Partials/_SidebarItem" model='new SidebarItemViewModel { Text = "Retiro", Icon = "arrow-up-from-line", Area = "Cashier", Controller = "Transactions", Action = "Withdrawal" }' />
    <partial name="Partials/_SidebarItem" model='new SidebarItemViewModel { Text = "Pago a tarjeta de crédito", Icon = "credit-card", Area = "Cashier", Controller = "CreditCardPayments", Action = "Create" }' />
    <partial name="Partials/_SidebarItem" model='new SidebarItemViewModel { Text = "Pago a préstamo", Icon = "landmark", Area = "Cashier", Controller = "Transactions", Action = "LoanPayment" }' />
    <partial name="Partials/_SidebarItem" model='new SidebarItemViewModel { Text = "Transacciones a cuentas de terceros", Icon = "send", Area = "Cashier", Controller = "Transactions", Action = "ThirdPartyTransfer" }' />
}

@RenderBody()

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
