@model ABP.WebApp.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Crear nueva contraseña";
}

<div class="flex min-h-screen items-center justify-center bg-surface-muted px-4">
    <div class="w-full max-w-sm">
        <div class="mb-6">
            <h1 class="text-lg font-semibold text-ink">Crear nueva contraseña</h1>
            <p class="text-sm text-ink-muted">Defina la nueva contraseña para su cuenta.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.TokenError))
        {
            <div class="alert alert-danger" role="alert">@Model.TokenError</div>
            <div class="card p-6 text-center">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Volver al inicio de sesión</a>
            </div>
        }
        else
        {
            <form class="card space-y-4 p-6" asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger" role="alert">@Model.Error</div>
                }

                <div>
                    <label asp-for="Password" class="mb-1 block text-sm font-medium text-ink-soft">Contraseña</label>
                    <input asp-for="Password" class="input" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="mt-1 block text-sm text-danger"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="mb-1 block text-sm font-medium text-ink-soft">Confirmar contraseña</label>
                    <input asp-for="ConfirmPassword" class="input" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="mt-1 block text-sm text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-full">Restablecer contraseña</button>
            </form>
        }
    </div>
</div>
