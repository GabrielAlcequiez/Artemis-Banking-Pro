@model ABP.WebApp.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="flex min-h-screen items-center justify-center bg-surface-muted px-4">
    <div class="w-full max-w-sm">
        <div class="mb-6">
            <h1 class="text-lg font-semibold text-ink">Restablecer contraseña</h1>
            <p class="text-sm text-ink-muted">Ingrese su nombre de usuario para recibir un enlace de restablecimiento.</p>
        </div>

        <form class="card space-y-4 p-6" asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-danger" role="alert">@Model.Error</div>
            }

            <div>
                <label asp-for="Username" class="mb-1 block text-sm font-medium text-ink-soft">Nombre de usuario</label>
                <input asp-for="Username" class="input" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="mt-1 block text-sm text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-full">Enviar solicitud</button>

            <p class="text-center text-sm">
                <a asp-controller="Account" asp-action="Login" class="text-ink-soft underline-offset-4 hover:underline">Volver al inicio de sesión</a>
            </p>
        </form>
    </div>
</div>
