@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="flex min-h-screen items-center justify-center bg-surface-muted px-4">
    <div class="card w-full max-w-sm p-6 text-center">
        <h1 class="text-lg font-semibold text-ink">Acceso denegado</h1>
        <p class="mt-2 text-sm text-ink-muted">No tiene permisos para acceder a esta sección.</p>

        <div class="mt-6 flex flex-col gap-2">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Volver al inicio de sesión</a>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-ghost w-full">Cerrar sesión</button>
            </form>
        </div>
    </div>
</div>
