@model ABP.WebApp.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="flex min-h-screen items-center justify-center bg-gray-50 px-4">
    <div class="max-w-md rounded-lg bg-white p-8 text-center shadow-md">
        <h1 class="text-3xl font-bold text-red-700">Ha ocurrido un error inesperado</h1>
        <p class="mt-4 text-gray-600">Lo sentimos, algo salió mal. Intente de nuevo más tarde.</p>
        <a href="/" class="mt-6 inline-block rounded bg-amber-700 px-4 py-2 text-white hover:bg-amber-800">Volver al inicio</a>
    </div>
</div>
