@model ABP.WebApp.Areas.Admin.ViewModels.SavingsAccounts.SavingsAccountIndexViewModel
@{
    ViewData["Title"] = "Gestión de cuentas de ahorro";
    var page = Model.Result;
    var currentStatus = string.IsNullOrWhiteSpace(Model.Status) ? "todas" : Model.Status.ToLowerInvariant();
    var currentType = string.IsNullOrWhiteSpace(Model.Type) ? "todas" : Model.Type.ToLowerInvariant();
}

<div class="mx-auto max-w-7xl space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-ink">Gestión de cuentas de ahorro</h1>
            <p class="mt-1 text-sm text-ink-muted">Consulta, abre y administra las cuentas secundarias de los clientes.</p>
        </div>
        <a class="btn btn-primary" asp-action="SelectClient">Abrir cuenta secundaria</a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert border-success/30 bg-success/10 text-success" role="status">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <form method="get" class="card grid gap-4 p-4 md:grid-cols-[minmax(0,1fr)_10rem_10rem_auto] md:items-end">
        <div>
            <label for="ownerIdentification" class="mb-1 block text-sm font-medium text-ink-soft">Cédula del cliente</label>
            <input id="ownerIdentification" name="ownerIdentification" value="@Model.OwnerIdentification" maxlength="11"
                   class="input" placeholder="00000000000" />
        </div>
        <div>
            <label for="status" class="mb-1 block text-sm font-medium text-ink-soft">Estado</label>
            <select id="status" name="status" class="input">
                <option value="todas" selected="@(currentStatus == "todas")">Todas</option>
                <option value="activa" selected="@(currentStatus == "activa")">Activas</option>
                <option value="cancelada" selected="@(currentStatus == "cancelada")">Canceladas</option>
            </select>
        </div>
        <div>
            <label for="type" class="mb-1 block text-sm font-medium text-ink-soft">Tipo</label>
            <select id="type" name="type" class="input">
                <option value="todas" selected="@(currentType == "todas")">Todos</option>
                <option value="principal" selected="@(currentType == "principal")">Principal</option>
                <option value="secundaria" selected="@(currentType == "secundaria")">Secundaria</option>
            </select>
        </div>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a class="btn btn-ghost" asp-action="Index">Limpiar</a>
        </div>
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
    </form>

    <div asp-validation-summary="All" class="alert alert-danger empty:hidden" role="alert"></div>

    @if (page is null || page.Data.Count == 0)
    {
        <div class="card p-10 text-center">
            <h2 class="font-medium text-ink">No se encontraron cuentas</h2>
            <p class="mt-1 text-sm text-ink-muted">Modifica los filtros o abre una nueva cuenta secundaria.</p>
        </div>
    }
    else
    {
        <div class="card overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-border text-sm">
                    <thead class="bg-surface-sunken text-left text-xs uppercase tracking-wide text-ink-muted">
                        <tr>
                            <th class="px-4 py-3 font-medium">Cuenta</th>
                            <th class="px-4 py-3 font-medium">Titular</th>
                            <th class="px-4 py-3 font-medium">Tipo</th>
                            <th class="px-4 py-3 text-right font-medium">Saldo</th>
                            <th class="px-4 py-3 font-medium">Estado</th>
                            <th class="px-4 py-3 text-right font-medium">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border bg-surface">
                        @foreach (var account in page.Data)
                        {
                            var isActive = account.Status == ABP.Domain.Enums.SavingsAccountStatus.Active;
                            var isSecondary = account.Type == ABP.Domain.Enums.SavingsAccountType.Secondary;
                            <tr>
                                <td class="whitespace-nowrap px-4 py-3 font-mono text-ink">@account.AccountNumber</td>
                                <td class="px-4 py-3 text-ink-soft">@account.OwnerUserId</td>
                                <td class="px-4 py-3 text-ink-soft">@(isSecondary ? "Secundaria" : "Principal")</td>
                                <td class="tnum whitespace-nowrap px-4 py-3 text-right text-ink">RD$ @account.Balance.ToString("N2")</td>
                                <td class="px-4 py-3">
                                    <span class="badge @(isActive ? "badge-success" : "badge-neutral")">@(isActive ? "Activa" : "Cancelada")</span>
                                </td>
                                <td class="whitespace-nowrap px-4 py-3 text-right">
                                    <a class="btn btn-ghost px-2" asp-action="Details" asp-route-id="@account.Id">Ver detalles</a>
                                    @if (isActive && isSecondary)
                                    {
                                        <a class="btn btn-ghost px-2 text-danger" asp-action="ConfirmCancel" asp-route-id="@account.Id">Cancelar</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (page.TotalPages > 1)
        {
            <nav class="flex items-center justify-between gap-4" aria-label="Paginación de cuentas">
                <p class="text-sm text-ink-muted">Página @(page.Page) de @(page.TotalPages) · @(page.TotalRecords) registros</p>
                <div class="flex gap-2">
                    @if (page.Page > 1)
                    {
                        <a class="btn btn-ghost border border-border" asp-action="Index"
                           asp-route-page="@(page.Page - 1)" asp-route-pageSize="@(page.PageSize)"
                           asp-route-ownerIdentification="@Model.OwnerIdentification" asp-route-status="@currentStatus" asp-route-type="@currentType">Anterior</a>
                    }
                    @if (page.Page < page.TotalPages)
                    {
                        <a class="btn btn-ghost border border-border" asp-action="Index"
                           asp-route-page="@(page.Page + 1)" asp-route-pageSize="@(page.PageSize)"
                           asp-route-ownerIdentification="@Model.OwnerIdentification" asp-route-status="@currentStatus" asp-route-type="@currentType">Siguiente</a>
                    }
                </div>
            </nav>
        }
    }
</div>
