@model ABP.WebApp.Areas.Admin.ViewModels.SavingsAccounts.CancelSavingsAccountViewModel
@{
    ViewData["Title"] = "Cancelar cuenta";
}

<div class="mx-auto max-w-xl space-y-6">
    <div>
        <a class="text-sm text-ink-muted hover:text-ink" asp-action="Details" asp-route-id="@Model.AccountId">← Volver al detalle</a>
        <h1 class="mt-2 text-2xl font-semibold text-ink">Cancelar cuenta de ahorro</h1>
    </div>

    <section class="card space-y-5 p-6">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-danger/10 text-danger" aria-hidden="true">!</div>
        <div>
            <h2 class="text-lg font-semibold text-ink">¿Está seguro que desea cancelar la cuenta @Model.AccountNumber?</h2>
            <p class="mt-2 text-sm text-ink-muted">
                Si la cuenta tiene saldo, se transferirá automáticamente a la cuenta principal del cliente antes de cancelarla.
            </p>
        </div>

        <div asp-validation-summary="All" class="alert alert-danger empty:hidden" role="alert"></div>

        <form asp-action="Cancel" method="post" class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            @Html.AntiForgeryToken()
            <input asp-for="AccountId" type="hidden" />
            <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.AccountId">No, volver atrás</a>
            <button type="submit" class="btn border border-danger bg-danger text-white hover:opacity-90">Sí, cancelar cuenta</button>
        </form>
    </section>
</div>
