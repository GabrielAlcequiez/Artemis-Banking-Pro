@{
    ViewData["Title"] = "Home";
}

<div class="flex h-full flex-col items-center justify-center rounded-lg border border-dashed border-border p-10 text-center">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert mb-6 border-success/30 bg-success/10 text-success" role="status">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger mb-6" role="alert">@errorMessage</div>
    }
    <h1 class="text-lg font-semibold text-ink">Home del cajero</h1>
    <p class="mt-2 text-sm text-ink-muted">Los indicadores de operaciones se implementarán próximamente.</p>
</div>
