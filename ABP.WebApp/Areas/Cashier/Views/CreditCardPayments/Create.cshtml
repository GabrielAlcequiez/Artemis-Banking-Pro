@model ABP.WebApp.Areas.Cashier.ViewModels.CreditCards.CashierCreditCardPaymentViewModel
@{
    ViewData["Title"] = "Pago a tarjeta de crédito";
}

<div class="mx-auto max-w-3xl space-y-6">
    <header>
        <a class="text-sm text-ink-muted hover:text-ink"
           asp-area="Cashier" asp-controller="Home" asp-action="Index">← Volver al Home</a>
        <h1 class="mt-3 text-2xl font-semibold text-ink">Pago a tarjeta de crédito</h1>
        <p class="mt-1 text-sm text-ink-muted">
            Registra un pago desde una cuenta de ahorro activa hacia una tarjeta activa.
        </p>
    </header>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <form asp-action="Confirm" method="post" class="card space-y-5 p-6">
        @Html.AntiForgeryToken()
        <input asp-for="OperationId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="space-y-2">
            <label asp-for="SourceAccountNumber" class="text-sm font-medium text-ink">Número de cuenta origen</label>
            <input asp-for="SourceAccountNumber" class="input" inputmode="numeric" autocomplete="off" />
        </div>

        <div class="space-y-2">
            <label asp-for="CreditCardNumber" class="text-sm font-medium text-ink">Número de tarjeta</label>
            <input asp-for="CreditCardNumber"
                   class="input"
                   inputmode="numeric"
                   autocomplete="off"
                   maxlength="16" />
            <p class="text-xs text-ink-muted">El número completo no se mostrará en la confirmación.</p>
        </div>

        <div class="space-y-2">
            <label asp-for="Amount" class="text-sm font-medium text-ink">Monto a pagar</label>
            <input asp-for="Amount" class="input" type="number" min="0.01" step="0.01" />
        </div>

        <button type="submit" class="btn btn-primary">Continuar</button>
    </form>
</div>
