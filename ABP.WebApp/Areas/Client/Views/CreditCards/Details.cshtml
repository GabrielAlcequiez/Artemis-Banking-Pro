@model ABP.WebApp.Areas.Client.ViewModels.CreditCards.CreditCardDetailViewModel
@{
    ViewData["Title"] = "Detalle de tarjeta";
    var card = Model.Card;
    var isActive = string.Equals(card.Status, "Activa", StringComparison.OrdinalIgnoreCase);
}

<div class="mx-auto max-w-6xl space-y-6">
    <header>
        <a class="text-sm text-ink-muted hover:text-ink"
           asp-area="Client"
           asp-controller="Home"
           asp-action="Index">← Volver al Home</a>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-2xl font-semibold text-ink">@card.MaskedCardNumber</h1>
                <p class="mt-1 text-sm text-ink-muted">Consulta el balance y los consumos de tu tarjeta.</p>
            </div>
            <span class="badge @(isActive ? "badge-success" : "badge-neutral")">@card.Status</span>
        </div>
    </header>

    <section class="card p-5" aria-labelledby="card-summary-heading">
        <h2 id="card-summary-heading" class="font-medium text-ink">Información general</h2>
        <dl class="mt-5 grid gap-5 text-sm sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <dt class="text-ink-muted">Límite</dt>
                <dd class="tnum mt-1 font-medium text-ink">RD$ @card.CreditLimit.ToString("N2")</dd>
            </div>
            <div>
                <dt class="text-ink-muted">Crédito disponible</dt>
                <dd class="tnum mt-1 font-medium text-ink">RD$ @card.AvailableCredit.ToString("N2")</dd>
            </div>
            <div>
                <dt class="text-ink-muted">Monto adeudado</dt>
                <dd class="tnum mt-1 font-medium text-ink">RD$ @card.CurrentDebt.ToString("N2")</dd>
            </div>
            <div>
                <dt class="text-ink-muted">Expiración</dt>
                <dd class="mt-1 font-medium text-ink">@card.ExpirationDate</dd>
            </div>
        </dl>
    </section>

    <section class="space-y-3" aria-labelledby="consumptions-heading">
        <div class="flex items-center justify-between gap-3">
            <h2 id="consumptions-heading" class="text-lg font-semibold text-ink">Consumos</h2>
            <span class="text-sm text-ink-muted">@card.Consumptions.Count registros</span>
        </div>

        @if (card.Consumptions.Count == 0)
        {
            <div class="card p-8 text-center text-sm text-ink-muted">
                Esta tarjeta todavía no tiene consumos registrados.
            </div>
        }
        else
        {
            <div class="card overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-border text-sm">
                        <thead class="bg-surface-sunken text-left text-xs uppercase tracking-wide text-ink-muted">
                            <tr>
                                <th class="px-4 py-3 font-medium">Fecha</th>
                                <th class="px-4 py-3 font-medium">Comercio</th>
                                <th class="px-4 py-3 text-right font-medium">Monto</th>
                                <th class="px-4 py-3 font-medium">Estado</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border bg-surface">
                            @foreach (var consumption in card.Consumptions)
                            {
                                var approved = string.Equals(
                                    consumption.Status,
                                    "APROBADO",
                                    StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <td class="whitespace-nowrap px-4 py-3 text-ink-soft">
                                        @consumption.Date.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="px-4 py-3 text-ink">@consumption.CommerceName</td>
                                    <td class="tnum whitespace-nowrap px-4 py-3 text-right text-ink">
                                        RD$ @consumption.Amount.ToString("N2")
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="badge @(approved ? "badge-success" : "badge-danger")">
                                            @consumption.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
</div>
