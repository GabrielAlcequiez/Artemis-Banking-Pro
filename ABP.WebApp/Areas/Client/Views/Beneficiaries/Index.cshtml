@model ABP.WebApp.Areas.Client.ViewModels.Accounts.BeneficiaryIndexViewModel
@{
    ViewData["Title"] = "Beneficiarios";
}

<div class="mx-auto max-w-3xl space-y-6">
    <header>
        <a class="text-sm text-ink-muted hover:text-ink"
           asp-area="Client" asp-controller="Home" asp-action="Index">← Volver al Home</a>
        <h1 class="mt-3 text-2xl font-semibold text-ink">Beneficiarios</h1>
        <p class="mt-1 text-sm text-ink-muted">
            Guarda cuentas de otros clientes para transferirles dinero más rápido.
        </p>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert border-success/30 bg-success/10 text-success" role="status">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <section class="card p-6" aria-labelledby="add-beneficiary-heading">
        <h2 id="add-beneficiary-heading" class="font-medium text-ink">Agregar beneficiario</h2>
        <form asp-action="Add" method="post" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end">
            @Html.AntiForgeryToken()
            <div class="flex-1 space-y-2">
                <label asp-for="BeneficiaryAccountNumber" class="text-sm font-medium text-ink">Número de cuenta</label>
                <input asp-for="BeneficiaryAccountNumber" class="input" maxlength="9" placeholder="000000000" />
                <span asp-validation-for="BeneficiaryAccountNumber" class="text-sm text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Agregar</button>
        </form>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger empty:hidden mt-3"></div>
    </section>

    <section class="space-y-3" aria-labelledby="beneficiaries-heading">
        <h2 id="beneficiaries-heading" class="text-lg font-semibold text-ink">Tus beneficiarios</h2>

        @if (Model.Beneficiaries.Count == 0)
        {
            <div class="card p-8 text-center text-sm text-ink-muted">Todavía no tienes beneficiarios guardados.</div>
        }
        else
        {
            <div class="card overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-border text-sm">
                        <thead class="bg-surface-sunken text-left text-xs uppercase tracking-wide text-ink-muted">
                            <tr>
                                <th class="px-4 py-3 font-medium">Nombre</th>
                                <th class="px-4 py-3 font-medium">Cuenta</th>
                                <th class="px-4 py-3 font-medium">Agregado</th>
                                <th class="px-4 py-3 text-right font-medium">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border bg-surface">
                            @foreach (var beneficiary in Model.Beneficiaries)
                            {
                                <tr>
                                    <td class="px-4 py-3 text-ink">@beneficiary.BeneficiaryOwnerName</td>
                                    <td class="whitespace-nowrap px-4 py-3 font-mono text-ink-soft">@beneficiary.BeneficiaryAccountNumber</td>
                                    <td class="whitespace-nowrap px-4 py-3 text-ink-soft">@beneficiary.CreatedAtUtc.ToString("dd/MM/yyyy")</td>
                                    <td class="whitespace-nowrap px-4 py-3 text-right">
                                        <form asp-action="Remove" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="beneficiaryId" value="@beneficiary.Id" />
                                            <button type="submit" class="btn btn-ghost px-2 text-danger">Quitar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
</div>
